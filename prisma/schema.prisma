generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(cuid())
  name                 String?
  email                String         @unique
  password             String
  plan                 String         @default("Gratuit")
  searchesRemaining    Int            @default(3)
  freeSearchQuotaVersion Int          @default(1)
  stripeCustomerId     String?        @unique
  stripeSubscriptionId String?        @unique
  active               Boolean        @default(true)
  createdAt            DateTime       @default(now())
  searches             Search[]
  favorites            Favorite[]
  campaigns            Campaign[]
  searchUsages         SearchUsage[]
}

model Search {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  niche     String
  language  String
  subsMin   String
  subsMax   String
  results   String
  createdAt DateTime @default(now())
}

model Favorite {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  channelId        String
  name             String
  subs             String?
  subsNum          Int?
  niche            String?
  lang             String?
  score            Int?
  scoreLabel       String?
  scoreReason      String?
  email            String?
  instagram        String?
  tiktok           String?
  twitch           String?
  website          String?
  channelUrl       String?
  aboutUrl         String?
  desc             String?
  avatar           String?
  color            String?
  thumbnail        String?
  totalViews       Float?
  videoCount       Int?
  channelCreatedAt DateTime?
  createdAt        DateTime  @default(now())

  @@unique([userId, channelId])
}

model SearchCache {
  id        String   @id @default(cuid())
  cacheKey  String   @unique
  niche     String
  lang      String
  subsMin   Int
  subsMax   Int
  results   Json
  createdAt DateTime @default(now())
  expiresAt DateTime
  algorithmVersion String @default("youtube-search-v3")
}

model SearchUsage {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId   String    @unique
  cacheKey    String
  plan        String
  periodKey   String
  status      String    @default("pending")
  cached      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, createdAt])
  @@index([userId, status])
}

model SearchLock {
  id        String   @id @default(cuid())
  userId    String   @unique
  requestId String   @unique
  cacheKey  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Campaign {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  name      String
  status    String             @default("Brouillon")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  prospects CampaignProspect[]
}

model CampaignProspect {
  id               String    @id @default(cuid())
  campaignId       String
  campaign         Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  channelId        String
  name             String
  email            String?
  instagram        String?
  tiktok           String?
  twitch           String?
  website          String?
  channelUrl       String?
  avatar           String?
  thumbnail        String?
  score            Int?
  scoreLabel       String?
  scoreReason      String?
  generatedSubject String?
  generatedBody    String?
  status           String    @default("À contacter")
  createdAt        DateTime  @default(now())

  @@unique([campaignId, channelId])
}
